# Agentic Coach environment variables. Copy to .env.local for local development, and set the same
# names in Vercel → Project → Settings → Environment Variables. Never commit real values.

# --- Access gate (Fix #2) -------------------------------------------------------------------
# Comma-separated beta access codes you give to testers. Required: without it every protected API
# route returns 503 and the app shows "Coaching access isn't set up yet".
BETA_ACCESS_CODES=
# Secret used to sign the httpOnly access cookie. Required, at least 32 characters.
# Generate one with: openssl rand -hex 32
ACCESS_COOKIE_SECRET=
# How long an unlocked browser stays unlocked, in hours (default 12).
ACCESS_SESSION_TTL_HOURS=12
# Local development only: set to true to skip the access gate. Ignored when NODE_ENV=production.
ACCESS_GATE_DISABLED=

# Per-minute rate limits (in-memory, per server instance; best-effort abuse brake).
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_IP_PER_MINUTE=60
VOICE_TOKEN_RATE_LIMIT_PER_MINUTE=6
VOICE_TOKEN_RATE_LIMIT_PER_IP_PER_MINUTE=20
DELIVERY_RATE_LIMIT_PER_MINUTE=10
DELIVERY_RATE_LIMIT_PER_IP_PER_MINUTE=30

# --- Existing integrations (unchanged names) ----------------------------------------------------
# LLM for /api/chat and /api/llm. Without a key, /api/chat answers with a built-in scripted fallback.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_ENDPOINT=
# Session storage
MONGO_DB_CONNECTION_STRING=
MONGO_DB_NAME=coaching
# Action-plan email and calendar invites (Resend)
RESEND_API_KEY=
ACTION_PLAN_FROM_EMAIL=
CALENDAR_FROM_EMAIL=
# Optional beta-username trial mode (Beta1–Beta8)
NEXT_PUBLIC_REQUIRE_BETA_LOGIN=false
NEXT_PUBLIC_VOICE_ENABLE_WEBSOCKET_FALLBACK=true
# --- ElevenLabs voice (Fix #3) ---------------------------------------------------------------
# Your current agent and voice IDs are kept privately (not in this public repo); set them in Vercel.
# Server-side: the only agent(s) the token route will mint for.
ELEVENLABS_AGENT_ID=
ELEVENLABS_ALLOWED_AGENT_IDS=
# Required for signed conversation tokens (recommended; make the agent private in ElevenLabs).
ELEVENLABS_API_KEY=
# Only if you deliberately keep a public agent and have no API key: let browsers connect directly.
ELEVENLABS_ALLOW_PUBLIC_AGENT=false
# Optional client hint; must also be in the allow-list above.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Optional voice IDs (not secret). Unset = the agent's default voice.
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_MALE=
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_FEMALE=
